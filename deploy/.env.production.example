# DNS A record for this hostname must point to the VPS before first startup.
APP_DOMAIN=fan.example.com
# Existing Nginx deployment alternative, e.g. srv1610573.hstgr.cloud
VPS_HOSTNAME=

# Generate URL-safe values, for example: openssl rand -hex 32
APP_SECRET_KEY=
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Leave blank only if generation integrations are intentionally disabled.
SPORTMONKS_API_TOKEN=
# Identifiant d'équipe Sportmonks du FC Barcelona, requis pour initialiser le seed multi-équipe.
BARCELONA_EXTERNAL_TEAM_ID=
OPENAI_API_KEY=
LLM_MODEL=
